{
  "compilerOptions": {
    "declaration": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "module": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "moduleResolution": "node16"
  },
  "include": ["./src/**/*"],
  "ts-node": {
    "esm": true
  }
}
